[Unit]
Description=Publish allowlisted Instap ZIP request statistics
After=nginx.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/instap-downloads/publish-download-stats.py
TimeoutStartSec=120
StateDirectory=instap-downloads
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/log/instap-downloads /usr/local/lib/instap-downloads
ReadWritePaths=/var/lib/instap-downloads/public
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryMax=256M

